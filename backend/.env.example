# Alens Backend Configuration

# Application
APP_NAME=Alens
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for application storage)
DATABASE_URL=postgresql+asyncpg://alens:alens@db:5432/alens

# Redis (for caching)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
CACHE_PREVIEW_TTL_SECONDS=60

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=change-this-32-byte-key-in-prod!

# Default admin user
DEFAULT_USERNAME=wnkadmin
DEFAULT_PASSWORD=wnkadmin

# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4-turbo-preview
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

